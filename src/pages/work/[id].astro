---
import Shell from '@/layouts/Shell.astro';
import EvidenceList from '@/components/EvidenceList.astro';
import Architecture from '@/components/Architecture.astro';
import { pageData } from '@/lib/page-data';
import { routes } from '@/lib/knowledge/routes';
import { getCollection, render } from 'astro:content';
import '@/styles/pages/pages.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
const { data, labels } = await pageData();
const p = data.projects.find((x) => x.id === entry.id)!;
const { Content } = await render(entry);
const parent = data.experience.find((x) => x.id === p.parent) ?? null;
const parentEdu = data.education.find((x) => x.id === p.parent) ?? null;
const decisions = data.decisions.filter((d) => d.project === p.id);
const evidence = data.evidence.filter((v) => p.evidence.includes(v.id) || v.supports.includes(p.id));
const related = data.projects
  .filter((x) => x.id !== p.id && x.skills.some((s) => p.skills.includes(s)))
  .slice(0, 3);
const attrHref = (id: string) =>
  data.skills.some((s) => s.id === id)
    ? routes.skill(id)
    : routes.technology(data.technologies.find((t) => t.id === id)?.skill ?? id, id);
const meta = {
  title: p.name,
  description: `${p.tagline} ${p.summary}`.slice(0, 300),
  path: routes.project(p.id),
  type: 'article' as const,
};
const repo = evidence.find((e) => e.kind === 'repository');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.name,
  description: p.summary,
  url: `https://kevilpatel.in${routes.project(p.id)}`,
  author: { '@type': 'Person', name: data.profile.name, url: 'https://kevilpatel.in/' },
  keywords: p.stack.map((t) => labels[t] ?? t).join(', '),
  ...(repo ? { codeRepository: repo.url } : {}),
};
---

<Shell meta={meta} current="work" jsonLd={jsonLd}>
  <article class="project" style={`--vt:project-${p.id}`}>
    <header class="project-head">
      <p class="eyebrow project-head__kind">
        <span class="kind-dot" style="--kind:var(--kind-project)"></span> {p.kind}
        {parent && (
          <>
            {' '}
            · within <a href={routes.role(parent.id)}>{parent.org}</a>
          </>
        )}
        {parentEdu && (
          <>
            {' '}
            · during <a href={routes.educationEntry(parentEdu.id)}>{parentEdu.institution}</a>
          </>
        )}
        · {p.period.label}
      </p>
      <h1 class="project-head__title">{p.name}</h1>
      <p class="project-head__tagline">{p.tagline}</p>
      {p.period.note && <p class="note note--warn">{p.period.note}</p>}
      <ul class="cluster" role="list" style="--cluster-gap:4px">
        {p.stack.map((t) => (
          <li>
            <a class="attr" href={attrHref(t)}>
              {labels[t] ?? t}
            </a>
          </li>
        ))}
      </ul>
    </header>

    <div class="two-col">
      <div class="flow" style="--flow:var(--sp-6)">
        <section aria-labelledby="summary">
          <h2 id="summary" class="section__title">
            What it is
          </h2>
          <p>{p.summary}</p>
          {p.problem && (
            <>
              <h3 class="span-detail__h">Problem</h3>
              <p class="muted">{p.problem}</p>
            </>
          )}
        </section>

        {p.architecture && (
          <section aria-labelledby="arch" data-story>
            <h2 id="arch" class="section__title">
              How it flows
            </h2>
            <p class="small faint">
              Pipeline as described publicly; scroll the approach to follow each stage.{' '}
              <cite class="src mono" title={p.architecture.source}>
                src
              </cite>
            </p>
            <Architecture arch={p.architecture} />
          </section>
        )}

        {p.approach.length > 0 && (
          <section aria-labelledby="approach">
            <h2 id="approach" class="section__title">
              Approach
            </h2>
            <ol class="story" role="list">
              {p.approach.map((step, i) => (
                <li class="story__step" data-story-step={i}>
                  <span class="story__num" aria-hidden="true">
                    {i + 1}
                  </span>
                  <p>{step}</p>
                </li>
              ))}
            </ol>
          </section>
        )}

        {p.outcomes.length > 0 && (
          <section aria-labelledby="outcomes">
            <h2 id="outcomes" class="section__title">
              Outcomes
            </h2>
            <ul class="claims" role="list">
              {p.outcomes.map((o, i) => (
                <li class="claim" style={`--i:${i}`}>
                  <span class="claim__marker" aria-hidden="true"></span>
                  <div>
                    <p>{o.text}</p>
                    <div class="claim__meta">
                      <span title={o.source}>source: {o.source.split('#')[0]}</span>
                      {o.selfReported && (
                        <span class="status-pill" data-tone="warn">
                          as stated in résumé
                        </span>
                      )}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}

        {decisions.length > 0 && (
          <section aria-labelledby="decisions">
            <h2 id="decisions" class="section__title">
              Decisions
            </h2>
            <div class="stack" style="--stack-gap:var(--sp-3)">
              {decisions.map((d) => (
                <article class="decision" id={`decision-${d.id}`}>
                  <h3 class="decision__title">◆ {d.title}</h3>
                  <dl>
                    <div>
                      <dt>Context</dt>
                      <dd>{d.context}</dd>
                    </div>
                    <div>
                      <dt>Decision</dt>
                      <dd>{d.decision}</dd>
                    </div>
                    {d.consequence && (
                      <div>
                        <dt>Consequence</dt>
                        <dd>{d.consequence}</dd>
                      </div>
                    )}
                  </dl>
                  <span class="small faint mono">source: {d.source.split('#')[0]}</span>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="prose" aria-label="Notes">
          <Content />
        </section>
      </div>

      <aside class="flow">
        <h2 class="span-detail__h">Evidence</h2>
        <EvidenceList evidence={evidence} />
        {p.skills.length > 0 && (
          <>
            <h2 class="span-detail__h">Skills demonstrated</h2>
            <ul class="cluster" role="list" style="--cluster-gap:4px">
              {p.skills.map((s) => (
                <li>
                  <a class="chip" href={routes.skill(s)}>
                    {labels[s] ?? s}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        {related.length > 0 && (
          <>
            <h2 class="span-detail__h">Related work</h2>
            <ul class="span-detail__list" role="list">
              {related.map((r) => (
                <li>
                  <a href={routes.project(r.id)}>{r.name}</a>
                </li>
              ))}
            </ul>
          </>
        )}
        <h2 class="span-detail__h">Sources</h2>
        <ul class="span-detail__list" role="list">
          {p.sources.map((s) => (
            <li class="mono small">{s}</li>
          ))}
        </ul>
        <a class="btn" href={`${routes.compare()}?ids=${p.id}`}>
          Compare with another project
        </a>
      </aside>
    </div>
  </article>

  <script>
    import { initStory } from '@/features/projects/story';
    const boot = () => {
      const el = document.querySelector<HTMLElement>('[data-story]');
      if (el && !el.dataset.ready) {
        el.dataset.ready = '1';
        initStory(el);
      }
    };
    boot();
    document.addEventListener('astro:page-load', boot);
  </script>
</Shell>
