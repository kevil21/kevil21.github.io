---
import { portfolio } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import EvidenceLinks from '../components/EvidenceLinks.astro';
const { profile } = portfolio;
---
<Layout title="Profile & experience">
  <div class="reading"><header class="page-intro" id="profile"><p class="eyebrow">The person behind the work</p><h1>{profile.name}</h1><p>{profile.role}</p></header><p class="lead">{profile.summary}</p><p>{profile.location}</p>
    <nav class="reading-nav" aria-label="Profile sections"><a href="#experience">Experience</a><a href="#education">Education</a><a href="#achievements">Achievements</a><a href="/credentials/">Credentials</a><a href="/evidence/#skills">Skills</a><a href="#contact">Contact</a></nav>
    <section id="experience"><h2>Work &amp; community</h2>{portfolio.experience.map((item) => <article class="record" id={item.id}><p class="eyebrow">{item.period}</p><h3>{item.title}</h3><p class="label">{item.organization}</p><p>{item.summary}</p><EvidenceLinks ids={item.evidenceIds} /></article>)}</section>
    <section id="education"><h2>Education</h2>{portfolio.education.map((item) => <article class="record" id={item.id}><p class="eyebrow">{item.period}</p><h3>{item.title}</h3><p>{item.institution}</p><p>{item.detail}</p><EvidenceLinks ids={item.evidenceIds} /></article>)}</section>
    <section id="achievements"><h2>Achievements</h2>{portfolio.achievements.map((item) => <article class="record" id={item.id}><h3>{item.title}</h3><p>{item.summary}</p><EvidenceLinks ids={item.evidenceIds} /></article>)}</section>
    <section><h2>Languages</h2><ul>{profile.languages.map((language) => <li>{language}</li>)}</ul></section>
    <section id="contact"><p class="eyebrow">Start a conversation</p><h2>Let’s connect.</h2><a class="text-link" href={`mailto:${profile.email}`}>{profile.email} ↗</a><ul class="chips">{profile.links.map((link) => <li><a href={link.url}>{link.label} ↗</a></li>)}</ul><a class="button-link" href="/resume/">Read or print the résumé →</a></section>
  </div>
</Layout>