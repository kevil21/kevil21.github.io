---
import { portfolio } from '../lib/content';
import { domains, domainNotes } from '../lib/routes';
import { evidenceFor, skillsFor, jsonForHtml } from '../lib/presentation';
import Layout from '../layouts/Layout.astro';
import EvidenceLinks from '../components/EvidenceLinks.astro';
import PersonaControl from '../components/PersonaControl.astro';
const first = portfolio.projects[0]!;
const atlasData = { projects: portfolio.projects.map((project) => ({ ...project, evidence: evidenceFor(project.evidenceIds), skills: skillsFor(project) })), journeys: portfolio.journeys };
---
<Layout title="Evidence Atlas" wide>
  <div class="atlas-intro">
    <div class="page-intro"><p class="eyebrow">Kevil Patel / Engineering portfolio</p><h1>Systems, connected.<br /><em>Evidence, attached.</em></h1><p>Explore the work through its architecture, implementation, and sources.</p></div>
    <p class="edition">FIELD NOTES<br />{String(portfolio.projects.length).padStart(2, '0')} PROJECTS<br />{portfolio.evidence.length} SOURCE EXCERPTS</p>
  </div>
  <PersonaControl />
  <div class="atlas-controls" data-enhancement hidden>
    <fieldset class="domain-filters"><legend class="label">Explore a domain</legend><div class="segmented">
      {['all', ...domains].map((domain) => <button type="button" data-domain-filter={domain} aria-pressed={domain === 'all'} aria-controls="project-map">{domain === 'all' ? 'All work' : domain.charAt(0).toUpperCase() + domain.slice(1)}</button>)}
    </div></fieldset>
    <fieldset><legend class="label">View</legend><div class="segmented"><button type="button" data-atlas-view="map" aria-pressed="true">Map</button><button type="button" data-atlas-view="list" aria-pressed="false">List</button></div></fieldset>
  </div>
  <div class="section-heading"><h2 id="projects-heading">The project atlas</h2><p class="note" data-project-count>{portfolio.projects.length} projects / four domains</p></div>
  <p class="note">Connections show editorial domain membership, not data flow between projects. Reading order is not a ranking.</p>
  <div class="atlas-workspace" data-atlas>
    <div class="atlas-center">
      <section class="atlas-canvas" id="project-map" data-view="map" aria-labelledby="projects-heading">
        {domains.map((domain, index) => <section class="domain-lane" data-domain={domain} aria-labelledby={`domain-${domain}`}>
          <svg class="topology" data-topology aria-hidden="true" focusable="false"><path /></svg>
          <h3 class="domain-heading" id={`domain-${domain}`}><span>{String(index + 1).padStart(2, '0')}</span>{domain}</h3>
          <p class="domain-note">{domainNotes[domain]}</p>
          <ul class="domain-projects">{portfolio.projects.filter((project) => project.domain === domain).map((project) => <li data-project-item={project.id}>
            <article class="project-node" data-project={project.id} data-selected={project.id === first.id ? 'true' : 'false'}>
              <div class="node-topline"><span class="node-id">{project.id === 'a360' || project.id === 'policy-to-pipelines' ? 'SYSTEM STUDY' : 'PROJECT NOTE'}</span><button class="inspect" type="button" data-inspect={project.id} data-enhancement hidden aria-label={`Inspect ${project.title}`} aria-pressed={project.id === first.id} aria-controls="inspector">Inspect ↗</button></div>
              <h3><a href={`/projects/${project.id}/`}>{project.title}</a></h3><p class="subtitle">{project.subtitle}</p>
              <ul class="chips" aria-label="Selected technologies">{project.technologies.slice(0, 3).map((technology) => <li>{technology}</li>)}</ul>
              <details><summary>Evidence / {project.evidenceIds.length} excerpts</summary><div class="disclosure-body"><p>{project.summary}</p><EvidenceLinks ids={project.evidenceIds} /><p class="label">Evidence-linked skills</p><ul class="chips">{skillsFor(project).map((skill) => <li><a href={`/evidence/#${skill.id}`}>{skill.name}</a></li>)}</ul></div></details>
            </article>
          </li>)}</ul>
        </section>)}
      </section>
    </div>
    <aside class="inspector" id="inspector" aria-labelledby="inspector-title" tabindex="0" data-inspector>
      <p class="eyebrow inspector-label">Context / <span data-inspector-domain>{first.domain}</span></p>
      <h2 id="inspector-title" data-inspector-title>{first.title}</h2>
      <p data-inspector-summary>{first.summary}</p>
      <h3 class="label" data-inspector-lens>Recruiter perspective</h3><p data-inspector-perspective>{first.perspectives.recruiter}</p>
      <h3 class="label">Source excerpt</h3><blockquote data-inspector-quote>{evidenceFor(first.evidenceIds)[0]!.text}</blockquote>
      <p class="note" data-inspector-source>{evidenceFor(first.evidenceIds)[0]!.source} · source-provided, not independently verified.</p>
      <div data-inspector-evidence><EvidenceLinks ids={first.evidenceIds} /></div>
      <h3 class="label">Evidence-linked skills</h3><ul class="chips" data-inspector-skills>{skillsFor(first).map((skill) => <li><a href={`/evidence/#${skill.id}`}>{skill.name}</a></li>)}</ul>
      <div class="actions"><a class="button-link primary" data-inspector-link href={`/projects/${first.id}/`}>Read project →</a><a class="text-link" data-inspector-compare href={`/compare/?left=${first.id}`}>Compare</a></div>
      <p class="note">Open any project for every perspective and the complete evidence trail.</p>
      <a class="inspector-back" href="#projects-heading">← Back to projects</a>
    </aside>
  </div>
  <section class="journeys" aria-labelledby="journeys-heading"><div class="section-heading"><h2 id="journeys-heading">Choose a way in.</h2><a class="text-link" href="/experience/">The complete profile ↗</a></div>
    <div class="journey-grid">{portfolio.journeys.map((journey) => <article class="journey-card" id={journey.id}>
      <p class="eyebrow">For the {journey.persona}</p><h3>{journey.title}</h3><p class="note">{journey.description}</p>
      <ol>{journey.projectIds.map((id) => <li><a href={`/projects/${id}/`}>{portfolio.projects.find((project) => project.id === id)!.title}</a></li>)}</ol>
    </article>)}</div>
  </section>
  <script id="atlas-data" type="application/json" is:inline set:html={jsonForHtml(atlasData)} />
  <script>import { initializeAtlas } from '../scripts/atlas'; initializeAtlas();</script>
</Layout>