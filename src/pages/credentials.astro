---
import Shell from '@/layouts/Shell.astro';
import { pageData } from '@/lib/page-data';
import { routes } from '@/lib/knowledge/routes';
import { formatYM } from '@/lib/knowledge/dates';
import '@/styles/pages/pages.css';

const { data, labels } = await pageData();
const certs = [...data.certifications].sort((a, b) => (b.issued ?? '').localeCompare(a.issued ?? ''));
const meta = {
  title: 'Credentials',
  description: `${certs.length} certifications held by Kevil Patel from AWS, Microsoft, GitHub and Founderz, each with its credential ID and verification link.`,
  path: routes.credentials(),
};
const logo: Record<string, { src?: string; inline?: string; alt: string }> = {
  aws: { src: '/images/derived/aws-160.png', alt: 'Amazon Web Services' },
  founderz: { src: '/images/derived/founderz-160.png', alt: 'Founderz' },
  microsoft: {
    inline:
      '<svg viewBox="0 0 24 24" width="36" height="36" role="img" aria-label="Microsoft"><rect x="2" y="2" width="9.5" height="9.5" fill="#f25022"/><rect x="12.5" y="2" width="9.5" height="9.5" fill="#7fba00"/><rect x="2" y="12.5" width="9.5" height="9.5" fill="#00a4ef"/><rect x="12.5" y="12.5" width="9.5" height="9.5" fill="#ffb900"/></svg>',
    alt: 'Microsoft',
  },
  github: {
    inline:
      '<svg viewBox="0 0 24 24" width="36" height="36" role="img" aria-label="GitHub" fill="#181717"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"/></svg>',
    alt: 'GitHub',
  },
};
---

<Shell meta={meta} current="credentials">
  <header class="page-head">
    <span class="eyebrow">credentials · {certs.length} attestations</span>
    <h1 class="page-head__title">Certifications</h1>
    <p class="page-head__lede">
      Every credential lists its ID and where to verify it. Dates are shown as issued and expiry months; no
      "active" badges are inferred.
    </p>
    <p class="note">
      Issue months come from Kevil's LinkedIn certification export; expiry months from the portfolio source.
      Verify any credential through the issuer link.
    </p>
  </header>

  <div class="stack" style="--stack-gap:var(--sp-3)">
    {certs.map((c) => {
      const l = logo[c.issuerId]!;
      return (
        <article class="cert" id={c.id} data-cert={c.id}>
          <div class="cert__logo">
            {l.src ? (
              <img src={l.src} alt={l.alt} width="36" height="36" loading="lazy" />
            ) : (
              <Fragment set:html={l.inline} />
            )}
          </div>
          <div class="flow" style="--flow:var(--sp-2)">
            <h2 class="cert__name">
              {c.code && (
                <span class="mono" style="color: var(--ink-kind-certification)">
                  {c.code} ·{' '}
                </span>
              )}
              {c.name}
            </h2>
            <div class="cert__meta">
              <span>{c.issuer}</span>
              {c.issued && <span>issued {formatYM(c.issued)}</span>}
              {c.expires && (
                <span>{c.expires === 'none' ? 'no expiry' : `expires ${formatYM(c.expires)}`}</span>
              )}
            </div>
            {c.credentialId && (
              <div class="cert__id">
                <span>ID {c.credentialId}</span>
                <button
                  type="button"
                  class="copy-btn"
                  data-copy={c.credentialId}
                  aria-label={`Copy credential ID for ${c.name}`}
                >
                  copy
                </button>
              </div>
            )}
            {c.verifyNote && <p class="small faint">{c.verifyNote}</p>}
            <div class="cluster">
              <a class="btn small" href={c.verifyUrl} target="_blank" rel="noopener noreferrer external">
                Verify ↗
              </a>
              {c.skills.map((s) => (
                <a class="chip" href={routes.skill(s)}>
                  {labels[s] ?? s}
                </a>
              ))}
            </div>
          </div>
        </article>
      );
    })}
  </div>
  <script>
    import { pushToast } from '@/lib/stores/ui';
    document.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
      if (!b) return;
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = 'copied';
        pushToast({ text: 'Credential ID copied', tone: 'ok' });
        setTimeout(() => (b.textContent = 'copy'), 1600);
      } catch {
        pushToast({ text: 'Copy failed — select the ID manually', tone: 'warn' });
      }
    });
  </script>
</Shell>
