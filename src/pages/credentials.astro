---
import { portfolio } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import EvidenceLinks from '../components/EvidenceLinks.astro';
---
<Layout title="Credentials" description="Source-listed credentials with exact supplied links, IDs, and verification limitations.">
  <div class="reading"><header class="page-intro"><p class="eyebrow">Learning / source records</p><h1>Credentials,<br />with context.</h1><p>Exact source-listed records. A link is not an independent verification badge.</p></header>
    <nav class="reading-nav" aria-label="Credential index">{portfolio.certifications.map((item) => <a href={`#${item.id}`}>{item.title}</a>)}</nav>
    {portfolio.certifications.map((item) => <article class="record" id={item.id}><p class="eyebrow">{item.issuer}</p><h2>{item.title}</h2>{item.credentialId && <p class="record-meta">Credential ID: {item.credentialId}</p>}<p>{item.verificationNote}</p><a class="text-link" href={item.url}>Open supplied credential / issuer link ↗</a><EvidenceLinks ids={item.evidenceIds} /></article>)}
  </div>
</Layout>