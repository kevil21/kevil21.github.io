---
import type { Evidence } from '@/lib/schema';
interface Props {
  evidence: Evidence[];
  emptyText?: string;
}
const {
  evidence,
  emptyText = 'No external evidence is linked for this item; the claims above come from the résumé and are marked as self-reported.',
} = Astro.props;
const icon: Record<Evidence['kind'], string> = {
  repository:
    'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.2-.4-3.9 1.4a13.4 13.4 0 0 0-7 0C6.2.3 5 .7 5 .7a4.8 4.8 0 0 0-.1 3.6A5.2 5.2 0 0 0 3.5 8c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.6V21',
  credential: 'M12 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM8 13l-1 8 5-3 5 3-1-8',
  profile: 'M20 21a8 8 0 1 0-16 0M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
  organisation: 'M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6',
  document: 'M6 3h9l4 4v14H6zM9 12h6M9 16h6',
  live: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm0 3v5l3 2',
};
---

{evidence.length === 0 ? (
  <p class="small faint evidence-empty">{emptyText}</p>
) : (
  <ul class="evidence-list" role="list">
    {evidence.map((v, i) => (
      <li class="evidence" style={`--i:${i}`}>
        <a href={v.url} target="_blank" rel="noopener noreferrer external">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={icon[v.kind]} />
          </svg>
          <span class="evidence__title">{v.title}</span>
          <span class="evidence__kind mono">{v.kind}</span>
        </a>
        {v.note && <span class="evidence__note small faint">{v.note}</span>}
      </li>
    ))}
  </ul>
)}
