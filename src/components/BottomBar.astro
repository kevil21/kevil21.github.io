---
import { routes } from '@/lib/knowledge/routes';
interface Props {
  current: string;
}
const { current } = Astro.props;
const items = [
  { href: routes.home(), label: 'Trace', key: 'trace', d: 'M3 6h8M3 12h14M3 18h11' },
  { href: '/work/', label: 'Work', key: 'work', d: 'M4 7h16v12H4zM9 7V4h6v3' },
  {
    href: routes.skills(),
    label: 'Skills',
    key: 'skills',
    d: 'M12 3l2.6 5.3L20 9l-4 3.9.9 5.8L12 16l-4.9 2.7.9-5.8L4 9l5.4-.7z',
  },
  { href: routes.resume(), label: 'Résumé', key: 'resume', d: 'M6 3h9l4 4v14H6zM9 12h6M9 16h6' },
];
---

<nav class="bottombar no-print" aria-label="Primary (mobile)">
  {items.map((n) => (
    <a href={n.href} class="bottombar__item" aria-current={current === n.key ? 'page' : undefined}>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={n.d} />
      </svg>
      <span>{n.label}</span>
    </a>
  ))}
  <button type="button" class="bottombar__item bottombar__cmd" data-open-palette aria-label="Search or ask">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="6" />
      <path d="m20 20-4.2-4.2" />
    </svg>
    <span>Ask</span>
  </button>
</nav>
