{
  "name": "kevilpatel-simulation-room",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "kevilpatel.in, generation 5 — The Simulation Room: a laboratory floor of working machines.",
  "engines": {
    "node": ">=24.9.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev --port 4440 --host 127.0.0.1",
    "preview": "node scripts/serve-dist.mjs --port 4441 --host 127.0.0.1",
    "preview:lan": "node scripts/lan-preview.mjs",
    "build": "astro build",
    "postbuild": "tsx scripts/build-service-worker.ts && tsx scripts/verify-public.ts",
    "check": "astro check && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.workers.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tokens:lint": "tsx scripts/lint-tokens.ts",
    "verify:public": "tsx scripts/verify-public.ts",
    "lighthouse": "lhci autorun",
    "assets": "tsx scripts/prepare-assets.ts",
    "brain": "tsx scripts/build-knowledge.ts",
    "prebuild": "npm run assets && tsx scripts/copy-ort.ts && npm run brain"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@mlc-ai/web-llm": "0.2.87",
    "@nanostores/persistent": "1.3.5",
    "@nanostores/preact": "1.1.1",
    "@preact/signals": "2.11.4",
    "astro": "7.4.4",
    "gsap": "3.15.0",
    "nanostores": "1.5.5",
    "preact": "11.1.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "@webgpu/types": "0.1.74",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "1.7.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "qrcode-terminal": "0.12.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
