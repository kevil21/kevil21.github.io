{
  "name": "kevilpatel-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx scripts/prepare-assets.ts",
    "build": "tsx scripts/build-knowledge.ts && astro build",
    "postbuild": "npm run build:sw",
    "build:sw": "tsx scripts/build-service-worker.ts",
    "check": "astro check && tsc --noEmit && tsc -p tsconfig.workers.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "brain": "tsx scripts/build-knowledge.ts",
    "assets": "tsx scripts/prepare-assets.ts",
    "validate": "npm run validate:workflows && npm run brain && npm run check && npm run lint && npm test && npm run build && npm run audit:public",
    "validate:workflows": "tsx scripts/validate-workflows.ts",
    "audit:public": "tsx scripts/verify-public.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@mlc-ai/web-llm": "0.2.87",
    "astro": "7.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "entities": "7.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "html-validate": "11.17.0",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
